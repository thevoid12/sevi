# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# The names here are the ones config.json refers to via "key_env".
# Every entry is REQUIRED (Sevi will not start without it) unless it is marked OPTIONAL.

# OpenRouter: chat, speech-to-text, text-to-speech (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Telegram bot token from @BotFather (see design/implementation.md, Phase 4)
TELEGRAM_BOT_TOKEN=

# OPTIONAL. Jina Reader (web page to text) works without a key; a key only raises
# its rate limits (https://jina.ai/reader). Leave empty or delete this line to skip it.
JINA_API_KEY=

# The secret every adapter (telegram, web...) signs its API calls with. Core refuses to
# start without it, and refuses any request not signed with it.
# Make one with:  openssl rand -hex 32
SEVI_JWT_SECRET=
