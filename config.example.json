{
  "app": {
    "listen": "127.0.0.1:8787",
    "data_dir": "data",
    "output_dir": "output",
    "retries": 2
  },

  "providers": {
    "openrouter": { "base_url": "https://openrouter.ai/api/v1", "key_env": "OPENROUTER_API_KEY" },
    "jina": { "base_url": "https://r.jina.ai", "key_env": "JINA_API_KEY" }
  },

  "models": {
    "llm": {
      "provider": "openrouter",
      "model": "",
      "system_prompt": "You are answering by voice. Reply in short, conversational speech of about 30 to 60 seconds. No markdown, lists or symbols. Answer in the language of the question. If asked for more, go deeper."
    },
    "tts": {
      "provider": "openrouter",
      "model": "google/gemini-3.8-flash-tts",
      "voice": "Kore",
      "chunk_chars": 3000
    }
  },

  "cost": {
    "confirm_over_usd": 0.30,
    "est_usd_per_1k_chars": 0.0,
    "show_in_reply": true
  },

  "telegram": {
    "enabled": false,
    "bot_token_env": "TELEGRAM_BOT_TOKEN",
    "allowed_user_ids": []
  },

  "log": {
    "level": "info",
    "dir": "logs",
    "max_size_mb": 20,
    "max_backups": 10,
    "max_age_days": 30
  }
}
